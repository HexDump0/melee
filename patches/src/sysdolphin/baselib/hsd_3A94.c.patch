+#ifdef PORT_PC
+/* CardState::file_sizes is int[9], but this file routinely carries a file
+ * index of 9: fn_803AC6B8_blocks_before opens with `if (file_idx >= 9) return
+ * 0;` and fn_803ACC50 tests `file_idx + 1 >= 9`, so the value is expected.
+ * The unguarded reads below then index one past the array, which lands on
+ * CardState::file_data[0] -- a pointer -- at offset 0x70.
+ *
+ * On the console that pointer is a MEM1 address (0x8xxxxxxx) or NULL, so as a
+ * signed int it is negative or zero either way, and every consumer's
+ * `file_sizes[...] <= 0` guard treats the file as empty.  On a 32-bit host the
+ * same pointer is usually below 0x80000000 and therefore *positive*, so the
+ * guard does not fire and a block count is computed from an address.
+ * fn_803AF3F0 then runs `for (i = 0; i < file_blocks; i++) block_map[i] = -1;`
+ * over a 64-entry *stack* array, i.e. a stack smash where the console simply
+ * does nothing.
+ *
+ * Return 0 for an out-of-range index: that is the outcome retail reaches on
+ * this path, by way of a value that happens to be non-positive there. */
+static inline s32 port_file_size(const CardState* state, s32 file_idx)
+{
+    if ((u32) file_idx >= 9u) {
+        return 0;
+    }
+    return state->file_sizes[file_idx];
+}
+#else
+/* Textually the original expression, so the GameCube build is unchanged. */
+#define port_file_size(st, idx) ((st)->file_sizes[idx])
+#endif

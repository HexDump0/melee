+#ifdef PORT_PC
+/* G-147: a POBJ_SHAPEANIM shape set is the one vertex pool HSD reads with the
+ * CPU instead of handing to the GX display-list decoder, so the port cannot
+ * byte-swap it in the converter (other PObjs share the same arrays, and the
+ * decoder needs them big-endian -- learnings/decomp_assets.md).  Swap on read
+ * here instead, exactly as the GX_INDEX16 index reads below already do by
+ * hand.  Without this every component decodes as a denormal near zero and the
+ * mesh collapses to a point. */
+static inline u16 shape_be16(void const* p)
+{
+    u8 const* b = p;
+    return (u16) ((b[0] << 8) | b[1]);
+}
+
+static inline f32 shape_be32f(void const* p)
+{
+    u8 const* b = p;
+    u32 v = ((u32) b[0] << 24) | ((u32) b[1] << 16) | ((u32) b[2] << 8) | b[3];
+    f32 f;
+    memcpy(&f, &v, sizeof(f));
+    return f;
+}
+
+static inline void shape_be32f_copy(void const* src, f32* dst, int n)
+{
+    int i;
+    for (i = 0; i < n; i++) {
+        dst[i] = shape_be32f((u8 const*) src + i * 4);
+    }
+}
+#endif

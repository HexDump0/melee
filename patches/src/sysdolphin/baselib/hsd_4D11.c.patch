diff --git a/src/sysdolphin/baselib/hsd_4D11.c b/src/sysdolphin/baselib/hsd_4D11.c
index 076608769..be6c3db62 100644
--- a/src/sysdolphin/baselib/hsd_4D11.c
+++ b/src/sysdolphin/baselib/hsd_4D11.c
@@ -7,9 +7,22 @@
 
 #include <Runtime/platform.h>
 
+#ifdef PORT_PC
+/* hsd_3A94.c casts hsd_804D1138 to CardContext (0x1510 bytes: four header
+ * words + CardCmd[128] + HsdCmdEntry[32]).  The console's symbols overlap:
+ * hsd_804D1148 is the command ring at +0x10 and hsd_804D2348 is the dispatch
+ * queue at +0x1210 (0x4D1138 + 0x1510 == 0x4D2648 == 0x4D2348 + 0x300).
+ * GCC will not overlap distinct arrays, so make the two sub-arrays symbol
+ * aliases into the base; allocating them separately splits the queue between
+ * its writers and the pump, which deadlocks the first file command (P-646). */
+u8 hsd_804D1138[0x1510];
+MELEE_ASM_ALIAS(hsd_804D1148, hsd_804D1138, 0x10);
+MELEE_ASM_ALIAS(hsd_804D2348, hsd_804D1138, 0x1210);
+#else
 /* 4D2348 */ u8 hsd_804D2348[0x300];
 /* 4D1148 */ u32 hsd_804D1148[0x80][0x9];
 /* 4D1138 */ u8 hsd_804D1138[0x10];
+#endif
 
 /* 4D799C */ s32 hsd_804D799C;
 /* 4D7998 */ s32 hsd_804D7998;

diff --git a/src/sysdolphin/baselib/sislib.c b/src/sysdolphin/baselib/sislib.c
index 4710af3d7..9c8fb13fa 100644
--- a/src/sysdolphin/baselib/sislib.c
+++ b/src/sysdolphin/baselib/sislib.c
@@ -1,3 +1,7 @@
+#ifdef PORT_PC
+#include <stdio.h>  /* P-730 trace */
+#include <stdlib.h> /* getenv */
+#endif
 #include "sislib.h"
 
 #include <printf.h> // IWYU pragma: keep
@@ -422,6 +426,25 @@ void HSD_SisLib_803A5E70(void)
     }
 
     HSD_SisLib_804D797C = NULL;
+#ifdef PORT_PC
+    /* The block below resets the SIS heap wholesale, so every HSD_Text that
+     * lived in it is gone.  804D7978 is the head of the text list and was
+     * left pointing into that memory, and HSD_SisLib_803A5ACC walks the list
+     * from it to find the tail before allocating the next text.
+     *
+     * The console survives that because the first allocation after a reset
+     * lands back on the old head's address, so the stale node is overwritten
+     * by the very text the walk is about to append to -- the list repairs
+     * itself by coincidence.  It only holds while the allocation sequence is
+     * identical; texts and their 0x10 string buffers interleave, so any
+     * divergence leaves the head aliasing a string buffer and the walk
+     * following freed memory.
+     *
+     * Clearing it is equivalent on the console path -- 803A5ACC assigns the
+     * head from the first text it allocates when the head is NULL -- and it
+     * removes the coincidence. */
+    HSD_SisLib_804D7978 = NULL;
+#endif
     free_head = HSD_SisLib_804D796C;
     used_head = NULL;
     free_head->next = NULL;
@@ -574,6 +597,21 @@ void HSD_SisLib_803A6368(HSD_Text* text, s32 sis_idx)
     if (sis_table != NULL) {
         text->sis_buffer = sis_table[sis_idx];
     }
+#ifdef PORT_PC
+    /* P-730.  This is the only place text->sis_buffer is ever assigned, so a
+     * NULL here is a text object that is valid, positioned and coloured and
+     * simply has no message -- a blank plate with nothing on stderr, which is
+     * what the trophy list rows look like.
+     *
+     * font_idx is the discriminator: the trophy rows are font 0, and the
+     * counter that renders correctly on the same screen is font 3. */
+    if (getenv("MELEE_TROPHY_TRACE") != NULL) {
+        fprintf(stderr,
+                "[sis] font=%d idx=%d table=%p entry=%p\n",
+                (int) text->font_idx, (int) sis_idx, (void*) sis_table,
+                sis_table != NULL ? (void*) sis_table[sis_idx] : NULL);
+    }
+#endif
     text->x60 = NULL;
     text->current_height = 0.0F;
     text->current_width = 0.0F;

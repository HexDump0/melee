diff --git a/src/sysdolphin/baselib/devcom.c b/src/sysdolphin/baselib/devcom.c
index 9193913b0..41fbd059d 100644
--- a/src/sysdolphin/baselib/devcom.c
+++ b/src/sysdolphin/baselib/devcom.c
@@ -1,5 +1,9 @@
 #include "devcom.h"
 
+#ifdef PORT_PC
+#include <stdio.h>
+#endif
+
 #include "debug.h"
 #include "devcom.static.h"
 #include "synth.h"
@@ -406,6 +410,44 @@ int HSD_DevComRequest(int file, uintptr_t src, uintptr_t dest, size_t size,
         !(HSD_DevComGetDestType(type) == DEVCOMDEST_SBUF
             && size > DEVCOM_BUF_SIZE));
 
+#ifdef PORT_PC
+    /* P-857: these four say only that *an* alignment rule broke, and the one
+     * that fires in the browser fires nowhere else, so there is no second run
+     * to put a breakpoint in.  Name the request instead: `type` alone
+     * separates an ARAM DMA from the 0x1B readdress, which reuses `src`,
+     * `dest` and `size` as two callbacks and a context and has no alignment
+     * to speak of. */
+    if (src % 32 != 0 || dest % 32 != 0 || size % 32 != 0 || size == 0) {
+        /* The ARAM high-water mark says which kind of address `dest` is: below
+         * it, an offset `ARAlloc` handed out; above it, a host pointer from
+         * the audio heap or a caller that is not doing a DMA at all. */
+        extern unsigned long melee_ar_debug_sp(void);
+        fprintf(stderr,
+                "devcom: file=%d src=%#lx dest=%#lx size=%#lx type=%#x "
+                "(src%%32=%lu dest%%32=%lu size%%32=%lu) aram_sp=%#lx %s\n",
+                file, (unsigned long) src, (unsigned long) dest,
+                (unsigned long) size, (unsigned) type,
+                (unsigned long) (src % 32), (unsigned long) (dest % 32),
+                (unsigned long) (size % 32),
+                (unsigned long) melee_ar_debug_sp(),
+                (unsigned long) dest < melee_ar_debug_sp() ? "dest=aram"
+                                                           : "dest=host");
+        /* Neither the address nor the type identifies the caller -- eleven
+         * call sites across synth.c, lbmthp.c, lbmemory.c and lbfile.c pass
+         * destinations from four different allocators, and the ones that
+         * matter are reached only on a boot path the desktop does not take.
+         * Ask the engine. */
+        {
+            extern void melee_port_backtrace(char* out, unsigned size);
+            char where[1024];
+            where[0] = '\0';
+            melee_port_backtrace(where, sizeof(where));
+            if (where[0] != '\0') {
+                fprintf(stderr, "devcom: called from\n%s\n", where);
+            }
+        }
+    }
+#endif
     HSD_ASSERT(0x1EF, src % 32 == 0);
     HSD_ASSERT(0x1F0, dest % 32 == 0);
     HSD_ASSERT(0x1F1, size % 32 == 0);

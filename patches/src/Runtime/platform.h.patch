 /// @deprecated Use #true instead.
 #undef TRUE
 
+/// Lay a bit-field group out the way MWCC does.
+///
+/// MWCC allocates the first bit-field at the **most** significant bit of the
+/// storage unit; GCC allocates at the least significant one.  Any group that
+/// is also written or read as a whole scalar -- through a union alias, or
+/// because the bytes came out of a `.dat` -- therefore lands on different bits
+/// on the two compilers, and the port silently disagrees with the console.
+///
+/// Prefer this over hand-reversing the field order.  Reversing only gives the
+/// right answer for a group that fills its storage unit exactly: reversing
+/// three `u8` bit-fields without adding five bits of padding puts `b0` at
+/// 0x04 rather than 0x80.  The attribute has no such trap and leaves the
+/// declaration readable.  See G-180/G-181.
+#ifdef PORT_PC
+#define PORT_BF_BE __attribute__((scalar_storage_order("big-endian")))
+#else
+#define PORT_BF_BE
+#endif
+
+#ifdef PORT_PC
+/// Boot entropy for the one seed Melee draws (see gmmain.c).
+///
+/// On console the seed is @c OSGetTick() sampled after GX comes up, and the
+/// drive spin-up before that point is what makes it differ from boot to boot.
+/// The port's timebase is a virtual counter that starts at zero and advances
+/// in fixed steps -- deliberately, so tick deltas and the boot log stay
+/// reproducible -- so the same sample comes back every time and the whole
+/// game plays out identically: the same 1P opponent order, the same stages,
+/// the same item drops.  Seeding from the host clock here fixes that without
+/// touching the timebase or ::HSD_Rand, which is console-exact.
+///
+/// @c MELEE_RNG_SEED pins the value for tests that replay a fixed demo.
+u32 PortRandomSeed(void);
+#endif
+
 /// The underlying type of an @c enum, used as a placeholder
 typedef int enum_t;
 

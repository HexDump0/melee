 static inline HSD_JObj* itLinkArrow_802A850C_inline(HSD_Joint* joint)
 {
+#ifdef PORT_PC
+    /* The guard admits a NULL joint, but the decompilation dropped whatever
+     * the function yields on that path and the result is stored into
+     * linkarrow.xB4[].  A jobj loaded from no joint is no jobj, and NULL is
+     * what every consumer of xB4[] already tests for. */
+    HSD_JObj* jobj = NULL;
+#else
     HSD_JObj* jobj;
+#endif
     if (joint != NULL) {
         jobj = HSD_JObjLoadJoint(joint);
     }

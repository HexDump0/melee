+/* The animlist command stream is archive data and stays big-endian, which is
+ * what the 81 `CMD_BE` sites in `lb/types.h` exist for -- but these reads
+ * bypass the union entirely by casting `cmd->u` to `u16*`/`s16*`, so
+ * `scalar_storage_order` never applies to them and a little-endian host reads
+ * every field byte-reversed.
+ *
+ * Measured on Green Greens, where a block taking damage runs this command with
+ * the bytes `28 00 | 00 00 | 05 15`: big-endian the bone index is
+ * `0x2800 & 0x3FF` = **0**, and little-endian it is `0x0028 & 0x3FF` = **40**.
+ * `it_80272CC0` then indexes `xBBC_dynamicBoneTable->bones[40]` on a model
+ * with far fewer bones, and `lb_8000B1CC` segfaults on the joint it gets back
+ * -- 18 of 156 Green Greens matches (P-788).  The effect id is wrong the same
+ * way, which is where the long-running `no effect from animlist <id>` reports
+ * come from: 1796 is `0x0704` read backwards. */
+static inline u16 itAnimlist_cmd_u16(const void* u, int i)
+{
+    const u8* b = (const u8*) u + (unsigned) i * 2;
+    return (u16) (((u16) b[0] << 8) | b[1]);
+}

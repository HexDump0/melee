+#define CMD_S16(u, i) ((s16) itAnimlist_cmd_u16((u), (i)))
+#else
+#define CMD_U16(u, i) (((u16*) (u))[i])
+#define CMD_S16(u, i) (((s16*) (u))[i])
+#endif

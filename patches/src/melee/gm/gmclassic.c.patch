+#ifdef PORT_PC
+/* These two are one region on the console -- `gmClassicIntroDataBuffer` at
+ * 0x80490880 (0x20) then `gm_804908A0` at 0x804908A0 (0x70), adjacent with
+ * nothing between -- and `gmClassicRuntimeData` (0x90) is that region typed.
+ * `gm_Mode_Classic_OnLoad` casts `&gmClassicIntroDataBuffer` to it and then
+ * shuffles the matchup order through `runtime[order_offset]`, where e.g.
+ * offset 0x80 is `gm_804908A0[0x60]` -- the same bytes as the `order`
+ * argument.  That is an ordinary Fisher-Yates written through the overlay.
+ *
+ * With `-fdata-sections` the two are separate objects, so the swap read and
+ * wrote 0x60 bytes past the intro buffer instead of the order array.  The
+ * order therefore stayed as `order[i].idx = i` and every playthrough drew the
+ * same opponent on the same stage -- and the writes landed in whatever the
+ * linker put after the buffer (P-750).
+ *
+ * Reproduce the layout: one block with both at the console's offsets.  Both
+ * names are file-local in use, so macros suffice. */
+struct gmClassic_block_80490880 {
+    /* +0x00 */ gmClassicIntroData intro;
+    /* +0x20 */ u8 state[112];
+};
+static struct gmClassic_block_80490880 gmClassic_block_80490880;
+STATIC_ASSERT(offsetof(struct gmClassic_block_80490880, state) == 0x20);
+STATIC_ASSERT(sizeof(struct gmClassic_block_80490880) == 0x90);
+#define gmClassicIntroDataBuffer (gmClassic_block_80490880.intro)
+#define gm_804908A0 (gmClassic_block_80490880.state)

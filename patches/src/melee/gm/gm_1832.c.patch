 #include <sysdolphin/baselib/util.h>
 #include <sysdolphin/baselib/wobj.h>
 
+#ifdef PORT_PC
+/* ADR-0011 patch: the write-gather FIFO at 0xCC008000 has no meaning on the
+ * host.  The `GXVert.h` shim already routes the SDK's inline vertex helpers
+ * (`GXPosition3f32`, `GXColor4u8`, ...) into the GX HLE, but these
+ * hand-inlined stores wrote the hardware address directly and segfaulted the
+ * moment particles started rendering (P-742/G-179).  The non-PORT_PC
+ * expansion is the original expression, so the GameCube build is unchanged.
+ */
+#define WGFIFO_F32(x) GXPortWGFifoF32(x)
+#define WGFIFO_U8(x) GXPortWGFifoU8(x)
+#else
+#define WGFIFO_F32(x) (GXWGFifo.f32 = (x))
+#define WGFIFO_U8(x) (GXWGFifo.u8 = (x))
+#endif

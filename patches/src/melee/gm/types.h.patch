 /// @deprecated Replace with inline bitfields
+/* This union is written as a whole byte and read as individual bN bits all
+ * over the codebase -- `Item::xDAA_flag` is the one that matters most, since
+ * `item.c:719` does `xDAA_byte = 1` and `it_8026EECC` then tests `b7` before
+ * drawing anything.  MWCC allocates the first bitfield at the MSB, so retail's
+ * `byte = 1` sets b7; GCC's LSB-first layout sets b0 and leaves b7 clear, and
+ * every item model stayed invisible (P-743/G-180).  Declaring the aliases in
+ * reverse under PORT_PC lands the named bits on the console's bits, so the
+ * raw byte and the bit names agree again -- and so does any flag byte that
+ * came out of an archive.
+ *
+ * `FtStatusFlags` in ft/types.h is the same fix applied to one field before
+ * the cause was understood to be this union; it is left alone. */
 typedef union UnkFlagStruct {
     u8 byte;
+#ifdef PORT_PC
+    struct {
+        u8 b7 : 1;
+        u8 b6 : 1;
+        u8 b5 : 1;
+        u8 b4 : 1;
+        u8 b3 : 1;
+        u8 b2 : 1;
+        u8 b1 : 1;
+        u8 b0 : 1;
+    };
+#else
     struct {
         u8 b0 : 1;
         u8 b1 : 1;
@@ -31,6 +55,7 @@ typedef union UnkFlagStruct {
         u8 b6 : 1;
         u8 b7 : 1;
     };
+#endif
 } UnkFlagStruct;
 

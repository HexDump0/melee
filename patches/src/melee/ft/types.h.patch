     /* +24 */ int x24;
 } Fighter_x1670_t; ///< @todo figure out proper size
 
+/* The fighter status byte is written raw (`x21FC_flag.byte = 1` in fighter.c)
+ * and read as individual bN bits (ftdrawcommon.c).  MWCC allocates the first
+ * bitfield at the MSB, so retail's `u8 = 1` sets b7; GCC's LSB-first layout
+ * would set b0 and leave b7 clear, hiding the model.  Declare the aliases in
+ * reverse under PORT_PC so the raw byte and the named bits agree. */
+typedef union FtStatusFlags {
+    u8 byte;
+#ifdef PORT_PC
+    struct {
+        u8 b7 : 1;
+        u8 b6 : 1;
+        u8 b5 : 1;
+        u8 b4 : 1;
+        u8 b3 : 1;
+        u8 b2 : 1;
+        u8 b1 : 1;
+        u8 b0 : 1;
+    };
+#else
+    struct {
+        u8 b0 : 1;
+        u8 b1 : 1;
+        u8 b2 : 1;
+        u8 b3 : 1;
+        u8 b4 : 1;
+        u8 b5 : 1;
+        u8 b6 : 1;
+        u8 b7 : 1;
+    };
+#endif
+} FtStatusFlags;
+
 struct Fighter {

 struct spawn_hitbox_skip {
     u8 _0[0xF];
+#ifdef PORT_PC
+    /* The retail code tests bit 3 of byte 0xF (`lbz` + `extrwi. r0, r0, 1,
+     * 28`): MWCC packs the five flags MSB-first from bit 7.  GCC packs
+     * bitfields LSB-first, so declare the flags in a single console-ordered
+     * byte.  Reading the u32 bitfield here returns bit 4 and skips every
+     * hitbox spawn (hitboxes never activate). */
+    u8 pad_xF : 3;
+    u8 xF_b4 : 1;
+    u8 xF_b3 : 1;
+    u8 xF_b2 : 1;
+    u8 xF_b1 : 1;
+    u8 xF_b0 : 1;
+#else
     u32 xF_b0 : 1;
     u32 xF_b1 : 1;
     u32 xF_b2 : 1;
     u32 xF_b3 : 1;
     u32 xF_b4 : 1;
+#endif
 };

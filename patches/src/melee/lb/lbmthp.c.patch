+#ifdef PORT_PC
+/* The THP header and each packed frame's size prefix are big-endian file
+ * words; the host reads the raw file bytes and has no converter pass for the
+ * movie (P-685). */
+static inline u32 lbmthp_be32(u32 value)
+{
+    return ((value & 0x000000FFu) << 24) | ((value & 0x0000FF00u) << 8) |
+           ((value & 0x00FF0000u) >> 8) | ((value & 0xFF000000u) >> 24);
+}
+#endif

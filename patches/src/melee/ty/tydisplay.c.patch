+#ifdef PORT_PC
+/* The console emits the three tables above back-to-back at 803B8988,
+ * 803B8A34 and 803B8AE0, and #tyDisplay_8031C454 / #tyDisplay_8031C5E4 reach
+ * the second and third by casting the address of the first to
+ * #TyDspNameTables* -- i.e. by reading 0xAC and 0x158 past it.
+ *
+ * The port builds with -fdata-sections, so each table gets its own section
+ * and the linker is free to place them anywhere.  It does: in the linked
+ * binary, 0x158 past `_tyDisplay_803B8988` is a function pointer, so
+ * `lbArchive_LoadSymbols` was handed a garbage filename and the VS splash
+ * died on `entry_num != -1` (lbfile.c:114).
+ *
+ * Read each table through its own symbol.  This is exact rather than
+ * approximate: the offsets the console uses land on precisely these three
+ * objects, which is what the address comments above record.  It is the
+ * `soundtest.c` treatment (P-718/G-166) -- rebase the overlay onto the real
+ * symbol -- rather than the `toy.c` one, because nothing here reads across a
+ * table boundary. */
+#define TYDSP_JOBJ_TABLE(tables) ((void) (tables), _tyDisplay_803B8988)
+#define TYDSP_MATANIM_TABLE(tables) ((void) (tables), _tyDisplay_803B8A34)
+#define TYDSP_ARCH_TABLE(tables) ((void) (tables), _tyDisplay_803B8AE0)
+#else
+#define TYDSP_JOBJ_TABLE(tables) (*(TyDspArchNames*) (tables)->jobj_names)
+#define TYDSP_MATANIM_TABLE(tables) (*(TyDspArchNames*) (tables)->matanim_names)
+#define TYDSP_ARCH_TABLE(tables) ((tables)->arch_names)
+#endif
+
 s32 tyDisplay_8031BB34(s8 idx)
 {
     TyDspArchNames table = _tyDisplay_803B8988;
@@ -2410,7 +2437,7 @@ s32 tyDisplay_8031C454(s32 arg0)
     temp = tables;
     if (archArr[idx] == NULL) {
         idx = entry->x04;
-        names1 = temp->arch_names;
+        names1 = TYDSP_ARCH_TABLE(temp);
         if ((s8) idx == -1) {
             idx = 0;
         }
@@ -2421,13 +2448,13 @@ s32 tyDisplay_8031C454(s32 arg0)
     }
 
     if (archArr[42] == NULL) {
-        names2 = tables->arch_names;
+        names2 = TYDSP_ARCH_TABLE(tables);

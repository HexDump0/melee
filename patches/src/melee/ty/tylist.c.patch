diff --git a/src/melee/ty/tylist.c b/src/melee/ty/tylist.c
index 549cf42f7..bb02a6588 100644
--- a/src/melee/ty/tylist.c
+++ b/src/melee/ty/tylist.c
@@ -864,8 +864,27 @@ void _tyList_8031438C(HSD_GObj* gobj)
         } else {
             TyListWaitData* wait_data = (TyListWaitData*) entry->x4;
             if (wait_data != NULL) {
+#ifdef PORT_PC
+                /* `entry->x4` is the list camera's HSD_GObj, and x20/x24 are a
+                 * u32 pair aliased over HSD_GObj::gxlink_prios -- a u64 at
+                 * +0x20.  Writing the halves separately is word-order
+                 * dependent: on PowerPC x20 lands in the **high** word and the
+                 * mask becomes 0x4210000000000000, GX links 62, 57 and 52.  On
+                 * a little-endian host x20 is the **low** word, so the same
+                 * two stores give 0x0000000042100000 -- links 30, 25 and 20,
+                 * every bit shifted down by 32.
+                 *
+                 * Link 62 is the one that matters: HSD_SisLib_803A5ACC puts
+                 * the trophy list's row text on it, so on the port no camera
+                 * rendered the rows and the list drew eleven empty plates with
+                 * correct ids, a working counter and nothing on stderr (P-730).
+                 *
+                 * State the whole u64 instead of assembling it from halves. */
+                ((HSD_GObj*) wait_data)->gxlink_prios = 0x4210000000000000ULL;
+#else
                 wait_data->x24 = 0;
                 wait_data->x20 = 0x42100000;
+#endif
             }
             state->x290 = HSD_SisLib_803A6754(3, _tyList_804D6EEC);
             state->x290->pos_z = 17.2f;

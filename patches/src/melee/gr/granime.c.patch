diff --git a/src/melee/gr/granime.c b/src/melee/gr/granime.c
index 26a021223..3766846e5 100644
--- a/src/melee/gr/granime.c
+++ b/src/melee/gr/granime.c
@@ -503,6 +503,54 @@ typedef void (*Callback3)(HSD_AObj* aobj, HSD_TObj* obj, int param);
 void grAnime_801C6F50(HSD_AObj* aobj, void* obj, u32 flags, void* func,
                       u32 type, void* param)
 {
+#ifdef PORT_PC
+    /* PowerPC passes integer/pointer arguments in r3.. and floats in f1..
+     * independently.  The retail calls below exploit that ABI by supplying
+     * a common oversized argument list.  Dispatch the declared AObj callback
+     * shapes explicitly on i386, where every argument shares the stack. */
+    switch (type) {
+    case AOBJ_ARG_A:
+        ((void (*)(HSD_AObj*)) func)(aobj);
+        break;
+    case AOBJ_ARG_AF:
+        ((void (*)(HSD_AObj*, f32)) func)(aobj, *(f32*) param);
+        break;
+    case AOBJ_ARG_AV:
+        ((void (*)(HSD_AObj*, void*)) func)(aobj, *(void**) param);
+        break;
+    case AOBJ_ARG_AU:
+        ((void (*)(HSD_AObj*, u32)) func)(aobj, *(u32*) param);
+        break;
+    case AOBJ_ARG_AO:
+        ((void (*)(HSD_AObj*, void*)) func)(aobj, obj);
+        break;
+    case AOBJ_ARG_AOF:
+        ((void (*)(HSD_AObj*, void*, f32)) func)(aobj, obj, *(f32*) param);
+        break;
+    case AOBJ_ARG_AOV:
+        ((void (*)(HSD_AObj*, void*, void*)) func)(aobj, obj,
+                                                   *(void**) param);
+        break;
+    case AOBJ_ARG_AOU:
+        ((void (*)(HSD_AObj*, void*, u32)) func)(aobj, obj, *(u32*) param);
+        break;
+    case AOBJ_ARG_AOT:
+        ((void (*)(HSD_AObj*, void*, u32)) func)(aobj, obj, flags);
+        break;
+    case AOBJ_ARG_AOTF:
+        ((void (*)(HSD_AObj*, void*, u32, f32)) func)(aobj, obj, flags,
+                                                      *(f32*) param);
+        break;
+    case AOBJ_ARG_AOTV:
+        ((void (*)(HSD_AObj*, void*, u32, void*)) func)(aobj, obj, flags,
+                                                        *(void**) param);
+        break;
+    case AOBJ_ARG_AOTU:
+        ((void (*)(HSD_AObj*, void*, u32, u32)) func)(aobj, obj, flags,
+                                                      *(u32*) param);
+        break;
+    }
+#else
     switch (type) {
     case 0:
         ((Event) func)();
@@ -541,6 +589,7 @@ void grAnime_801C6F50(HSD_AObj* aobj, void* obj, u32 flags, void* func,
         ((Callback4) func)(aobj, obj, flags, *(int*) param);
         break;
     }
+#endif
 }
 

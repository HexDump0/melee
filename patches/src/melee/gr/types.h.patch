 struct grCorneria_GroundVars {
+    /* `grcorneria.c:501-503` set `xC4.value = 1` and the rest of the file
+     * reads `xC4.flags.b0/b1/b2`.  MWCC puts b0 at 0x80, so on the console
+     * `value = 1` sets an unnamed bit and leaves all three named ones clear;
+     * GCC would put b0 at 0x01 and set it.  PORT_BF_BE keeps the two views
+     * agreeing (G-181). */
     union {
+#ifdef PORT_PC
+        /* MSB-first, written out: three of eight bits, so the group is padded
+         * to the top of the byte and then reversed.  PORT_BF_BE used to say
+         * this with an attribute Clang drops. */
         struct {
+            u8 : 5;
+            u8 b2 : 1;
+            u8 b1 : 1;
+            u8 b0 : 1;
+        } flags;
+#else
+        struct PORT_BF_BE {
             u8 b0 : 1;
             u8 b1 : 1;
             u8 b2 : 1;
         } flags;
+#endif
         u8 value;
     } xC4;
     u8 xC5;

diff --git a/src/melee/if/textlib.c b/src/melee/if/textlib.c
index bd8d18ba1..91e2ad2da 100644
--- a/src/melee/if/textlib.c
+++ b/src/melee/if/textlib.c
@@ -338,7 +338,13 @@ void DevText_Printf(DevText* text, char* format, ...)
     char str[64];
     va_list args;
     va_start(args, format);
+#ifdef PORT_PC
+    /* See G-149: glibc drops the last character when the size exceeds
+     * INT_MAX; the console reads -1 as unbounded. */
+    vsnprintf(str, sizeof(str), format, args);
+#else
     vsnprintf(str, -1, format, args);
+#endif
     va_end(args);
     DevText_Print(text, str);
 }

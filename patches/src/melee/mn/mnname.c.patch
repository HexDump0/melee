+     * 0x4D0 + 17 -> 0x4E4 + 19 -> 0x4F8 + 15 -> 0x508 + 17, ending where the
+     * comment below says the run ends -- which is what identifies which
+     * string belongs to which offset. */
+    if (lbLang_IsSavedLanguageUS()) {

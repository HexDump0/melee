 #include <sysdolphin/baselib/jobj.h>
 #include <sysdolphin/baselib/memory.h>
 
+#ifdef PORT_PC
+/* These eight are the second half of the same console overlay the asset block
+ * below already covers, and leaving them as their own objects is what broke
+ * the VS Records grid.
+ *
+ * `mnDiagram_Init` fills the models through `mnDiagram_Assets`, whose eight
+ * pointer arrays run from 0x94 to 0x118 -- and on the console those bytes
+ * *are* these descriptors.  The loader says so itself: it writes
+ * `&assets->NmB[0]` from `"MenMainNmB_Top_joint"`, `[1]` from
+ * `"..._animjoint"`, `[2]` from `"..._matanim_joint"` and `[3]` from
+ * `"..._shapeanim_joint"`, and `StaticModelDesc` is exactly
+ * `{ joint, animjoint, matanim_joint, shapeanim_joint }` in that order.
+ *
+ * Given separate objects here, the archive fills the block and every
+ * `MenMain*_Top` stays zero, so `mnDiagram_DrawCellValue` calls
+ * `HSD_JObjLoadJoint(NULL)` and `jobj.h:513` asserts `jobj` the moment the
+ * grid draws a number (P-826).  Alias them into the block at the console's
+ * offsets instead. */
+extern StaticModelDesc MenMainCursorB1_Top;
+extern StaticModelDesc MenMainSubB1_Top;
+extern StaticModelDesc MenMainNmB_Top;
+extern StaticModelDesc MenMainFaceB_Top;
+extern StaticModelDesc MenMainConB1_Top;
+HSD_GObj* mnDiagram_ScreenGObj;
+extern StaticModelDesc MenMainCursorB3_Top;
+extern StaticModelDesc MenMainConB3_Top;
+extern StaticModelDesc MenMainConB2_Top;
+#else
 StaticModelDesc MenMainCursorB1_Top;
 StaticModelDesc MenMainSubB1_Top;
 StaticModelDesc MenMainNmB_Top;
@@ -34,6 +62,7 @@ HSD_GObj* mnDiagram_ScreenGObj;
 StaticModelDesc MenMainCursorB3_Top;
 StaticModelDesc MenMainConB3_Top;
 StaticModelDesc MenMainConB2_Top;
+#endif
 
 #define GET_DIAGRAM(gobj) ((Diagram*) HSD_GObjGetUserData(gobj))
 
@@ -73,8 +102,60 @@ typedef struct mnDiagram_PopupAnimTableHead {
     /* 0x00 */ Point3d points[3];
 } mnDiagram_PopupAnimTableHead;
 
+#ifdef PORT_PC
+/* mnDiagram_Assets (0x118) is cast from &mnDiagram_FighterDisplayOrder, but
+ * that array is only its leading 0x1C bytes: sorted_names at 0x1C is
+ * mnDiagram_NameDisplayOrder, and the eight archive-asset pointer arrays from
+ * 0x94 are further symbols again in the same console run.  Thirty accesses go
+ * through that pointer, all but one of them past the base array.  With
+ * -fdata-sections these are separate sections the linker may place anywhere.
+ *
+ * Back the whole run with one object and bind the two named arrays into it at
+ * the console's offsets, so the 30 call sites stay as they are. */
+struct mnDiagram_AssetBlock {
+    /* +0x000 */ u8 fighters[0x1C];
+    /* +0x01C */ u8 names[0x78];
+    /* +0x094 */ u8 asset_ptrs[0x118 - 0x94];
+};
+struct mnDiagram_AssetBlock mnDiagram_asset_block;
+STATIC_ASSERT(sizeof(struct mnDiagram_AssetBlock) == sizeof(mnDiagram_Assets));
+STATIC_ASSERT(offsetof(struct mnDiagram_AssetBlock, names) ==
+              offsetof(mnDiagram_Assets, sorted_names));
+MELEE_ASM_ALIAS(mnDiagram_FighterDisplayOrder, mnDiagram_asset_block, 0x00);
+MELEE_ASM_ALIAS(mnDiagram_NameDisplayOrder, mnDiagram_asset_block, 0x1C);
+/* The eight model descriptors, at the offsets `mnDiagram_Assets` gives their
+ * pointer arrays.  Each is four pointers, which is `sizeof(StaticModelDesc)`,
+ * and the static asserts below tie these numbers to the struct rather than to
+ * this comment. */
+MELEE_ASM_ALIAS(MenMainSubB1_Top, mnDiagram_asset_block, 0x94);
+MELEE_ASM_ALIAS(MenMainNmB_Top, mnDiagram_asset_block, 0xA4);
+MELEE_ASM_ALIAS(MenMainFaceB_Top, mnDiagram_asset_block, 0xB4);
+MELEE_ASM_ALIAS(MenMainCursorB1_Top, mnDiagram_asset_block, 0xC4);
+MELEE_ASM_ALIAS(MenMainConB1_Top, mnDiagram_asset_block, 0xD4);
+MELEE_ASM_ALIAS(MenMainConB2_Top, mnDiagram_asset_block, 0xE4);
+MELEE_ASM_ALIAS(MenMainConB3_Top, mnDiagram_asset_block, 0xF4);
+MELEE_ASM_ALIAS(MenMainCursorB3_Top, mnDiagram_asset_block, 0x104);
+STATIC_ASSERT(sizeof(StaticModelDesc) == 4 * sizeof(void*));
+STATIC_ASSERT(offsetof(mnDiagram_Assets, SubB1) == 0x94);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, NmB) == 0xA4);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, FaceB) == 0xB4);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, CursorB1) == 0xC4);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, ConB1) == 0xD4);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, ConB2) == 0xE4);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, ConB3) == 0xF4);
+STATIC_ASSERT(offsetof(mnDiagram_Assets, CursorB3) == 0x104);
+/* Declared at the extent of the object they actually alias, not at their
+ * semantic length: several helpers take mnDiagram_FighterDisplayOrder as a
+ * `u8* sorted` and read sorted[idx + 0x1C], i.e. into the names array.  That
+ * is correct now the block guarantees adjacency, but a [0x1C] declaration
+ * would leave GCC believing otherwise -- the P-719 lesson. */
+extern u8 mnDiagram_FighterDisplayOrder[sizeof(struct mnDiagram_AssetBlock)];
+extern u8 mnDiagram_NameDisplayOrder[sizeof(struct mnDiagram_AssetBlock) -
+                                     0x1C];
+#else
 u8 mnDiagram_FighterDisplayOrder[0x1C];
 u8 mnDiagram_NameDisplayOrder[0x78];
+#endif
 

         OSReport(tbl->user_data_error);
         __assert(tbl->file_name, 0x5F8, tbl->user_data_name);
+#endif
     }
 
     GObj_InitUserData(gobj, 0, mnDiagram_PopupCleanup, user_data);
@@ -2597,8 +2650,12 @@ void mnDiagram_DrawFighterHeaders(HSD_GObj* arg0, int arg1, int arg2)
     HSD_JObj* row_jobj;
     int col_idx;
     int col_remaining;
+#ifdef PORT_PC
+    mnDiagram_Assets* assets = (mnDiagram_Assets*) &mnDiagram_asset_block;

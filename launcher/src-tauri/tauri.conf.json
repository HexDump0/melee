{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melee Unbound",
  "version": "1.0.0",
  "identifier": "dev.meleeunbound.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melee Unbound",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#000000",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Game"
  }
}
